        "pages": [
          "payments/payment-links",
          "payments/checkout",
          "payments/invoices"
        ]
      },
      {
        "group": "Storefront",
        "icon": "store",
        "pages": [
          "storefront/overview"
        ]
      },
      {
        "group": "Money",
        "icon": "wallet",
        "pages": [
          "money/wallet-and-payouts"
        ]
      },
      {
        "group": "Developers",
        "icon": "code",
        "pages": [
          "developers/api",
          "developers/sandbox",
          "developers/quickstart",
          "developers/payment-links",
          "developers/checkout",
          "developers/invoices",
          "developers/bills",
          "developers/webhooks",
          "developers/errors"
        ]
      },
      {
        "group": "Account",
        "icon": "shield-check",
        "pages": [
          "account/verification",
          "account/security"
        ]
      }
