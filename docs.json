{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vine",
  "colors": {
    "primary": "#0C0C0C",
    "light": "#3A3A36",
    "dark": "#D9F56F"
  },
  "favicon": "/images/vine-favicon-v2.png",
  "description": "Payments, payouts and storefronts for Nigerian businesses.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:image": "https://docs.vine.ng/images/vine-og-1200x630-v2.jpg",
      "og:image:type": "image/jpeg",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:image:alt": "Vine, payments without the workarounds",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.vine.ng/images/vine-og-1200x630-v2.jpg"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ],
        "icon": "rocket"
      },
      {
        "group": "Payments",
        "icon": "credit-card",
        "pages": [
          "payments/payment-links",
          "payments/checkout",
          "payments/invoices",
          "payments/international"
        ]
      },
      {
        "group": "Storefront",
        "icon": "store",
        "pages": [
          "storefront/overview"
        ]
      },
      {
        "group": "Money",
        "icon": "wallet",
        "pages": [
          "money/wallet-and-payouts",
          "money/store-plans"
        ]
      },
      {
        "group": "Developers",
        "icon": "code",
        "pages": [
          "developers/api",
          "developers/sandbox",
          "developers/test-cards",
          "developers/mcp",
          "developers/quickstart",
          "developers/payment-links",
          "developers/checkout",
          "developers/invoices",
          "developers/bills",
          "developers/verifications",
          "developers/webhooks",
          "developers/errors",
          "developers/subscriptions",
          "developers/embedded-checkout",
          "developers/sdks"
        ]
      },
      {
        "group": "API reference",
        "icon": "code",
        "openapi": {
          "source": "openapi.yaml",
          "directory": "api-reference"
        }
      },
      {
        "group": "Account",
        "icon": "shield-check",
        "pages": [
          "account/verification",
          "account/security"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/vine-logo-v2.png",
    "dark": "/images/vine-logo-white-v3.png"
  },
  "navbar": {
    "links": [
      {
        "href": "https://vine.ng",
        "label": "Website"
      },
      {
        "label": "Support",
        "href": "mailto:support@vine.ng"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://console.vine.ng"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/money/sims-and-plans",
      "destination": "/money/store-plans",
      "permanent": true
    }
  ],
  "footer": {
    "socials": {
      "x": "https://x.com/usevine_africa"
    }
  }
}
